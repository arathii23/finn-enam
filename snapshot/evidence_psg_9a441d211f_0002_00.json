{"passage": {"passage_id": "psg_9a441d211f_0002_00", "version_id": "ver_9a441d211fb5f76f", "page_index": 2, "printed_page": null, "speaker": null, "text": "Annexure I \n \nBrief Profile of Mr. Sanjay D\u2019Souza \n \n \nMr. Sanjay D\u2019Souza joined the Bank on December 1, 1999 and has close to 25 years of experience with \nthe Bank. \n \nHe has a diverse work experience in the Bank spanning Retail Credit, Wholesale Credit and Emerging \nEnterprises Group. Mr. D\u2019Souza has been heading business for Emerging Enterprises Group since \nOctober 2016 and Micro Enterprises Group was added to his portfolio effective February 2024. Further, \nwith effect from April 8, 2025, he would also be in charge of Business Banking \u2013 Working Capital. \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n.", "extraction_status": "extracted", "seq": 0, "printed_page_reason": "not identified by parser"}, "document": {"version_id": "ver_9a441d211fb5f76f", "doc_type": "exchange_filing", "period_label": null, "period_start": null, "period_end": null, "event_date": "2025-04-08", "source_url": "https://nsearchives.nseindia.com/corporate/HDFCBANK_08042025193422_SE_Intimation_Sanjay_Dsouza.pdf", "final_url": "https://nsearchives.nseindia.com/corporate/HDFCBANK_08042025193422_SE_Intimation_Sanjay_Dsouza.pdf", "host": "nsearchives.nseindia.com", "content_hash": "9a441d211fb5f76f3cd73938b1998ab1c36ee6499c139e11647e98bc7d0acb23", "bytes": 2688794, "page_count": 2, "published_at": "2025-04-08T14:08:20+00:00", "published_precision": "second", "availability_status": "verified", "availability_evidence": [{"method": "exchange_announcement", "source_url": "https://www.nseindia.com/api/corporate-announcements?index=equities&symbol=HDFCBANK&from_date=31-01-2025&to_date=30-04-2025", "source_hash": "61abe5dd4d50e824a48d1efb24bd7b8a5607f4f0039342859853967d1ac5d1f4", "matched_record": {"an_dt": "08-Apr-2025 19:38:19", "attFileSize": null, "attchmntFil