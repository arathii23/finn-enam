# Copy to .env in the project root. Existing environment variables take precedence.
# Never commit .env or paste actual keys into a chat.
# Claude runtime access (separate from the Claude Pro coding subscription):
ANTHROPIC_API_KEY=
FINN_MODEL_PROVIDER=anthropic
FINN_MODEL_PRIMARY=claude-haiku-5-5
FINN_MODEL_PRIMARY_EFFORT=low
FINN_MODEL_ESCALATION=claude-sonnet-5-5
FINN_MODEL_ESCALATION_EFFORT=medium
# Alternatively: FINN_MODEL_PROVIDER=openai, OPENAI_API_KEY=..., and
# FINN_MODEL_PRIMARY=gpt-6-luna / FINN_MODEL_ESCALATION=gpt-6.1-sol.
# Spending guards (USD, list-price reservations before each call)
FINN_API_BUDGET_USD=10
FINN_JOB_BUDGET_USD=0.50
# Storage
# Optional absolute path; omitted storage defaults to the project-root data folder.
# FINN_DATA_DIR=/absolute/path/to/data
