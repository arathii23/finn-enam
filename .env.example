# Copy to .env in the project root. Existing environment variables take precedence.
# Never commit .env or paste actual keys into a chat.
#
# DEFAULT = KEYLESS. With nothing set below, FINN runs with NO model and spends nothing:
# the Push digest, saved research briefs, quarterly tables, management cards,
# narrative-vs-numbers and a verbatim keyless "source brief" for fresh questions all work.
# This is the shipped submission configuration — the evaluator needs no key.
#
# ---------------------------------------------------------------------------------------
# OPTIONAL: genuine AI synthesis for FREE via Google Gemini (AI Studio free tier).
# Get a free key at https://aistudio.google.com/apikey — no billing required.
#   FINN_MODEL_PROVIDER=gemini
#   GEMINI_API_KEY=your-free-key
# Default models: gemini-2.0-flash (primary) / gemini-2.5-flash (escalation). Zero per-token
# cost; if the free rate limit is hit, FINN falls back to the keyless source brief.
# ---------------------------------------------------------------------------------------
# OPTIONAL: other providers (paid). Leave unset to keep the free, keyless default.
#   FINN_MODEL_PROVIDER=anthropic   ANTHROPIC_API_KEY=...   FINN_MODEL_PRIMARY=claude-haiku-5-5
#   FINN_MODEL_PROVIDER=openai      OPENAI_API_KEY=...      FINN_MODEL_PRIMARY=gpt-6-luna
#
FINN_MODEL_PRIMARY_EFFORT=low
FINN_MODEL_ESCALATION_EFFORT=medium
# Spending guards (USD, list-price reservations before each call). Ceilings, not budgets.
FINN_API_BUDGET_USD=5
FINN_JOB_BUDGET_USD=0.25
# Storage
# Optional absolute path; omitted storage defaults to the project-root data folder.
# FINN_DATA_DIR=/absolute/path/to/data
